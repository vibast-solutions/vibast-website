# AWS SES (interim email transport for the contact form; standard AWS credential env vars apply)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
CONTACT_EMAIL=
# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile). Site key is public (inlined at build time), secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
